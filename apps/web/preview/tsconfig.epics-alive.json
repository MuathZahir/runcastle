{
  // Typechecks the epics-that-look-alive design page: apps/web's own tsconfig
  // covers src and test only. Run: bunx tsc --noEmit -p preview/tsconfig.epics-alive.json
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@runcastle/server": ["../../../packages/server/src/trpc/router.ts"],
      "@tanstack/react-query": ["../node_modules/@tanstack/react-query"]
    }
  },
  "include": ["./epics-alive.tsx", "./epics-alive-data.ts"]
}
