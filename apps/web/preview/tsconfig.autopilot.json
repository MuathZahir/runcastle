{
  // Typechecks the epics-on-autopilot design pages: apps/web's own tsconfig
  // covers src and test only. Run: bunx tsc --noEmit -p preview/tsconfig.autopilot.json
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@runcastle/server": ["../../../packages/server/src/trpc/router.ts"],
      "@tanstack/react-query": ["../node_modules/@tanstack/react-query"],
      // The shared design-report helper lives outside apps/web: point its imports here.
      "react": ["../node_modules/@types/react"],
      "@runcastle/core": ["../node_modules/@runcastle/core"]
    }
  },
  "include": [
    "./autopilot-design-panel.tsx",
    "./autopilot-sidebar.tsx",
    "./autopilot-sidebar-data.ts",
    "./autopilot-feature.tsx",
    "./autopilot-feature-data.ts"
  ]
}
