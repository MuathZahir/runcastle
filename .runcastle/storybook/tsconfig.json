{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The web app's environment: the stories render its components.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    // The type-only router import apps/web/src/trpc.ts makes, mapped as
    // apps/web/tsconfig.json maps it.
    "paths": {
      "@runcastle/server": ["../../packages/server/src/trpc/router.ts"]
    }
  },
  // The catalogue's config and its stories — tsc's wildcards skip dot-folders,
  // so they are named explicitly. The app sources they import come along.
  "include": ["./**/*.ts", "./**/*.tsx", "../stories/**/*.ts", "../stories/**/*.tsx"]
}
