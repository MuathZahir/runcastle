{
  "name": "runcastle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "typecheck": "bun run --filter '@runcastle/core' --filter '@runcastle/server' typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
