{
  "name": "runcastle",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:tool": "bun run scripts/devtool.ts",
    "typecheck": "bun run --filter '@runcastle/core' --filter '@runcastle/server' --filter '@runcastle/web' typecheck && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p .runcastle/storybook/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "burn-cache:probe": "bun scripts/burn-cache-probe.ts",
    "deploy:worker": "bun run --filter '@runcastle/ping' deploy",
    "release": "bun run scripts/release.ts",
    "install:local": "bun run scripts/install-local.ts"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@storybook/react-vite": "10.6.2",
    "@tanstack/react-query": "5.101.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "bun-types": "1.3.14",
    "happy-dom": "20.11.13",
    "react": "19.2.7",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.122.0"
  },
  "patchedDependencies": {
    "@ai-hero/sandcastle@0.12.0": "patches/@ai-hero%2Fsandcastle@0.12.0.patch"
  }
}
