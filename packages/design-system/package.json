{
  "name": "@runcastle/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "runcastle design system — near-black IDE-grammar UI primitives (hairlines, one violet accent, mono identifiers).",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "src/fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2"
  }
}
