{
  "pkg": "@runcastle/design-system",
  "globalName": "Runcastle",
  "projectId": "e3ec89ac-f456-48cb-bd03-01bfd5d96c1b",
  "shape": "package",
  "buildCmd": "bunx tsc -p packages/design-system/tsconfig.json",
  "cssEntry": "src/styles.css",
  "extraFonts": "src/fonts/fonts.css",
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "DimLine": { "cardMode": "column" },
    "Panel": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "Toast": { "cardMode": "column" },
    "Toolbar": { "cardMode": "column" },
    "AppShell": { "cardMode": "single", "primaryStory": "Overview", "viewport": "1220x800" },
    "Titlebar": { "cardMode": "single", "viewport": "1060x120" },
    "Sidebar": { "cardMode": "single", "viewport": "340x380" },
    "Inspector": { "cardMode": "single", "viewport": "380x560" },
    "StatusBar": { "cardMode": "column", "viewport": "1060x120" },
    "OverviewScreen": { "cardMode": "single", "viewport": "900x680" },
    "TicketsScreen": { "cardMode": "single", "viewport": "900x680" },
    "RunScreen": { "cardMode": "single", "viewport": "1040x650" },
    "TerminalScreen": { "cardMode": "single", "viewport": "900x500" }
  }
}
