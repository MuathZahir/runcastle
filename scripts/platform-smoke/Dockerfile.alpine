# The musl variant of ./Dockerfile: README prerequisites PLUS the README's musl
# section. node-pty's linux prebuild is glibc-only, and without the toolchain and
# npm_config_build_from_source its install keeps that prebuild, which segfaults
# on load — so this checks the documented Alpine route, not a known dead end.
ARG BASE=alpine:3.22
FROM ${BASE}

ARG BUN_VERSION=1.3.14

# libstdc++/libgcc: Bun's musl build links against them. bash: the Bun installer.
# build-base + python3: node-gyp, for the source build.
RUN apk add --no-cache bash ca-certificates curl unzip git nodejs libstdc++ libgcc build-base python3
ENV npm_config_build_from_source=true

RUN adduser -D tester
USER tester
WORKDIR /home/tester
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}"
ENV PATH=/home/tester/.bun/bin:$PATH \
    RUNCASTLE_SMOKE_DISPOSABLE=1

COPY --chown=tester . /smoke/
CMD ["bun", "/smoke/smoke.ts"]
