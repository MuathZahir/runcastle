{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun-types"],
    // The scripts are run directly by bun, so they import sibling package
    // sources by their real `.ts` paths rather than through package exports.
    "allowImportingTsExtensions": true
  },
  // scripts/, plus the repo-root config files that belong to no workspace —
  // otherwise they are the next thing nothing typechecks — and `.runcastle/`
  // (drive scripts, scenarios), named by an explicit `**/*.ts` glob because
  // tsc's wildcards skip dot-folders otherwise.
  "include": [".", "../.runcastle/**/*.ts", "../vitest.config.ts", "../vitest.setup.ts"]
}
